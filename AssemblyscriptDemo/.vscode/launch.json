{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug AssemblyScript in Chrome",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "./debug/*": "${workspaceFolder}/*",
        "debug/*": "${workspaceFolder}/*"
      }
    }
  ]
}